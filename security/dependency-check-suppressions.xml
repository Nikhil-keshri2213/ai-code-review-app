<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        mxparser is an XML pull parser (io.github.x-stream:mxparser).
        The NVD CPE cpe:/a:xstream:xstream is a FALSE POSITIVE.
        mxparser is NOT the XStream serialization library.
        All XStream CVEs below are misattributed due to shared "x-stream"
        in the groupId. mxparser has no deserialization attack surface.
    -->
    <suppress>
        <notes>mxparser CPE mismatch - not the XStream serialization library</notes>
        <gav regex="true">io\.github\.x-stream:mxparser:.*</gav>
        <cpe>cpe:/a:xstream:xstream</cpe>
    </suppress>

</suppressions>
